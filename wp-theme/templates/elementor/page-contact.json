{
  "version": "0.4",
  "title": "RB / Page — Contact",
  "type": "page",
  "page_settings": { "template": "elementor_header_footer", "hide_title": "yes", "css_classes": "rb-page rb-page--contact" },
  "content": [
    {
      "id": "ct-hero",
      "elType": "section",
      "settings": {
        "layout": "full_width", "stretch_section": "section-stretched",
        "min_height": { "unit": "vh", "size": 45 }, "content_position": "middle",
        "css_classes": "rb-archive-hero is-dark",
        "background_color": "#0A0A0A",
        "padding": { "unit": "px", "top": "160", "right": "40", "bottom": "80", "left": "40",
          "mobile": { "top": "120", "right": "20", "bottom": "56", "left": "20" } }
      },
      "elements": [{
        "id": "ct-hero-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [
          { "id": "ct-bc", "elType": "widget", "widgetType": "breadcrumbs",
            "settings": { "text_color": "rgba(255,255,255,0.6)", "typography_font_size": { "unit": "rem", "size": 0.8125 } } },
          { "id": "ct-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Contact", "header_size": "span", "css_classes": "rb-eyebrow",
              "title_color": "rgba(255,255,255,0.6)",
              "typography_font_size": { "unit": "rem", "size": 0.75 }, "typography_letter_spacing": { "unit": "em", "size": 0.12 },
              "typography_text_transform": "uppercase",
              "_margin": { "unit": "px", "top": 16, "right": 0, "bottom": 12, "left": 0 } } },
          { "id": "ct-title", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Let's build what you need.", "header_size": "h1",
              "typography_font_size": { "unit": "rem", "size": 4 }, "typography_font_size_mobile": { "unit": "rem", "size": 2.25 },
              "typography_font_weight": "600", "typography_letter_spacing": { "unit": "em", "size": -0.03 },
              "title_color": "#FFFFFF" } }
        ]
      }]
    },

    { "id": "ct-form", "elType": "section", "_ref": "component-contact-form.json" },

    {
      "id": "ct-offices",
      "elType": "section",
      "settings": {
        "layout": "boxed", "content_width": { "unit": "px", "size": 1200 },
        "structure": "30",
        "css_classes": "rb-section rb-contact-offices",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [
        { "id": "ct-o1", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [
            { "id": "ct-o1-eye", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "APAC HQ", "header_size": "span", "css_classes": "rb-eyebrow", "title_color": "#71717A",
                "typography_font_size": { "unit": "rem", "size": 0.75 }, "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase" } },
            { "id": "ct-o1-city", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "Shenzhen", "header_size": "h3",
                "typography_font_size": { "unit": "rem", "size": 1.75 }, "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 8, "right": 0, "bottom": 12, "left": 0 } } },
            { "id": "ct-o1-addr", "elType": "widget", "widgetType": "text-editor",
              "settings": { "editor": "<p>Renobattery Industrial Park<br>Longgang District, Shenzhen 518000<br>China</p>",
                "typography_font_size": { "unit": "rem", "size": 0.9375 }, "text_color": "#52525B" } }
          ] },
        { "id": "ct-o2", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [
            { "id": "ct-o2-eye", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "EMEA", "header_size": "span", "css_classes": "rb-eyebrow", "title_color": "#71717A" } },
            { "id": "ct-o2-city", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "Frankfurt", "header_size": "h3",
                "typography_font_size": { "unit": "rem", "size": 1.75 }, "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 8, "right": 0, "bottom": 12, "left": 0 } } },
            { "id": "ct-o2-addr", "elType": "widget", "widgetType": "text-editor",
              "settings": { "editor": "<p>Taunusanlage 11<br>60329 Frankfurt am Main<br>Germany</p>",
                "typography_font_size": { "unit": "rem", "size": 0.9375 }, "text_color": "#52525B" } }
          ] },
        { "id": "ct-o3", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [
            { "id": "ct-o3-eye", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "Americas", "header_size": "span", "css_classes": "rb-eyebrow", "title_color": "#71717A" } },
            { "id": "ct-o3-city", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "Austin", "header_size": "h3",
                "typography_font_size": { "unit": "rem", "size": 1.75 }, "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 8, "right": 0, "bottom": 12, "left": 0 } } },
            { "id": "ct-o3-addr", "elType": "widget", "widgetType": "text-editor",
              "settings": { "editor": "<p>100 Congress Ave, Suite 2000<br>Austin, TX 78701<br>USA</p>",
                "typography_font_size": { "unit": "rem", "size": 0.9375 }, "text_color": "#52525B" } }
          ] }
      ]
    },

    {
      "id": "ct-map",
      "elType": "section",
      "settings": {
        "layout": "full_width", "stretch_section": "section-stretched",
        "css_classes": "rb-section rb-contact-map",
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0" }
      },
      "elements": [{
        "id": "ct-map-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [{
          "id": "ct-map-w", "elType": "widget", "widgetType": "google_maps",
          "settings": { "address": "Shenzhen, China", "zoom": { "unit": "px", "size": 11 },
            "height": { "unit": "px", "size": 480 }, "prevent_scroll": "yes" }
        }]
      }]
    }
  ]
}
