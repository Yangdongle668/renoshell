{
  "version": "0.4",
  "title": "RB / Single — Product",
  "type": "single",
  "condition": { "type": "single", "post_type": "product" },
  "page_settings": {
    "template": "elementor_header_footer",
    "hide_title": "yes",
    "css_classes": "rb-page rb-page--single rb-page--product"
  },
  "content": [
    {
      "id": "sp-hero",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "stretch_section": "section-stretched",
        "min_height": { "unit": "vh", "size": 90 },
        "content_position": "middle",
        "css_classes": "rb-product-hero is-dark",
        "background_background": "classic",
        "background_color": "#0A0A0A",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "80", "left": "40",
          "mobile": { "top": "96", "right": "20", "bottom": "64", "left": "20" } },
        "structure": "50"
      },
      "elements": [
        {
          "id": "sp-hero-col-gallery",
          "elType": "column",
          "settings": { "_column_size": 55, "_column_size_mobile": 100, "content_position": "center" },
          "elements": [
            {
              "id": "sp-gallery",
              "elType": "widget",
              "widgetType": "image-carousel",
              "settings": {
                "carousel": "{{acf:gallery}}",
                "image_size": "large",
                "slides_to_show": 1,
                "navigation": "both",
                "arrows_position": "outside",
                "dots_size": { "unit": "px", "size": 8 },
                "autoplay": "no",
                "image_fit": "contain",
                "css_classes": "rb-product-gallery",
                "image_stretch": "yes",
                "_animation": "fadeIn"
              }
            }
          ]
        },
        {
          "id": "sp-hero-col-info",
          "elType": "column",
          "settings": { "_column_size": 45, "_column_size_mobile": 100, "content_position": "center",
            "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "48",
              "mobile": { "top": "40", "right": "0", "bottom": "0", "left": "0" } } },
          "elements": [
            { "id": "sp-cat", "elType": "widget", "widgetType": "post-info",
              "settings": { "meta_data": [{ "type": "terms", "taxonomy": "product_cat" }],
                "css_classes": "rb-eyebrow", "color": "rgba(255,255,255,0.6)",
                "typography_font_size": { "unit": "rem", "size": 0.75 },
                "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase" } },
            { "id": "sp-title", "elType": "widget", "widgetType": "post-title",
              "settings": { "header_size": "h1",
                "typography_font_size": { "unit": "rem", "size": 4 },
                "typography_font_size_mobile": { "unit": "rem", "size": 2.5 },
                "typography_font_weight": "600",
                "typography_letter_spacing": { "unit": "em", "size": -0.03 },
                "typography_line_height": { "unit": "em", "size": 1.05 },
                "title_color": "#FFFFFF",
                "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 8, "left": 0 } } },
            { "id": "sp-model", "elType": "widget", "widgetType": "shortcode",
              "settings": { "shortcode": "[acf field='model_code']",
                "css_classes": "rb-product-model",
                "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 24, "left": 0 } } },
            { "id": "sp-key-specs", "elType": "widget", "widgetType": "icon-list",
              "settings": {
                "css_classes": "rb-product-key-specs",
                "icon_list": [
                  { "text": "{{acf:battery_capacity}} Ah capacity", "selected_icon": { "value": "fas fa-bolt", "library": "fa-solid" } },
                  { "text": "{{acf:nominal_voltage}} V nominal",   "selected_icon": { "value": "fas fa-plug", "library": "fa-solid" } },
                  { "text": "{{acf:energy_kwh}} kWh energy",        "selected_icon": { "value": "fas fa-battery-full", "library": "fa-solid" } },
                  { "text": "{{acf:cycle_life}} cycles @ 80% DoD",  "selected_icon": { "value": "fas fa-sync", "library": "fa-solid" } }
                ],
                "icon_color": "#1B6CFF",
                "text_color": "rgba(255,255,255,0.85)",
                "typography_font_size": { "unit": "rem", "size": 1 },
                "space_between": { "unit": "px", "size": 10 },
                "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 32, "left": 0 } } },
            { "id": "sp-cta-row", "elType": "section", "isInner": true,
              "settings": { "gap": "default", "structure": "20" },
              "elements": [
                { "id": "sp-cta-a-col", "elType": "column", "settings": { "_column_size": 50 }, "elements": [
                  { "id": "sp-cta-a", "elType": "widget", "widgetType": "button",
                    "settings": { "text": "Request Quote", "link": { "url": "/contact/?product={{post:slug}}" },
                      "size": "md", "css_classes": "rb-btn rb-btn--solid rb-btn--pill",
                      "button_text_color": "#0A0A0A", "background_color": "#FFFFFF",
                      "hover_background_color": "#E31937", "hover_color": "#FFFFFF",
                      "border_radius": { "unit": "px", "top": 999, "right": 999, "bottom": 999, "left": 999 } } } ] },
                { "id": "sp-cta-b-col", "elType": "column", "settings": { "_column_size": 50 }, "elements": [
                  { "id": "sp-cta-b", "elType": "widget", "widgetType": "button",
                    "settings": { "text": "Download Datasheet",
                      "link": { "url": "{{acf:datasheet_pdf}}", "is_external": true, "nofollow": true },
                      "size": "md", "css_classes": "rb-btn rb-btn--outline rb-btn--pill rb-btn--on-dark",
                      "button_text_color": "#FFFFFF", "background_color": "transparent",
                      "border_border": "solid", "border_color": "rgba(255,255,255,0.35)",
                      "selected_icon": { "value": "fas fa-download", "library": "fa-solid" },
                      "icon_align": "right",
                      "border_radius": { "unit": "px", "top": 999, "right": 999, "bottom": 999, "left": 999 } } } ] }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "sp-overview",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1200 },
        "css_classes": "rb-section rb-product-overview",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" },
        "structure": "33"
      },
      "elements": [
        { "id": "sp-ov-left", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 }, "elements": [
          { "id": "sp-ov-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Overview", "header_size": "span", "css_classes": "rb-eyebrow",
              "typography_font_size": { "unit": "rem", "size": 0.75 },
              "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase",
              "title_color": "#71717A" } }
        ] },
        { "id": "sp-ov-right", "elType": "column", "settings": { "_column_size": 66, "_column_size_mobile": 100 }, "elements": [
          { "id": "sp-ov-content", "elType": "widget", "widgetType": "theme-post-content",
            "settings": { "typography_font_size": { "unit": "rem", "size": 1.125 },
              "typography_line_height": { "unit": "em", "size": 1.7 },
              "text_color": "#3F3F46" } }
        ] }
      ]
    },

    {
      "id": "sp-specs",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1200 },
        "css_classes": "rb-section rb-product-specs",
        "background_color": "#FAFAFA",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [
        { "id": "sp-specs-col", "elType": "column", "settings": { "_column_size": 100 }, "elements": [
          { "id": "sp-specs-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Specifications", "header_size": "span", "css_classes": "rb-eyebrow",
              "typography_font_size": { "unit": "rem", "size": 0.75 },
              "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase",
              "title_color": "#71717A" } },
          { "id": "sp-specs-title", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Full technical specifications.", "header_size": "h2",
              "typography_font_size": { "unit": "rem", "size": 2.25 }, "typography_font_weight": "600",
              "typography_letter_spacing": { "unit": "em", "size": -0.015 },
              "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 40, "left": 0 } } },
          { "id": "sp-specs-table", "elType": "widget", "widgetType": "renobattery-spec-table",
            "settings": { "source": "acf:spec_table",
              "columns": 2, "striped": true, "css_classes": "rb-spec-table",
              "label_color": "#71717A", "value_color": "#0A0A0A",
              "row_padding_y": { "unit": "px", "size": 20 },
              "border_color": "#E5E5E7" } }
        ] }
      ]
    },

    {
      "id": "sp-downloads",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1200 },
        "css_classes": "rb-section rb-product-downloads",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40" },
        "structure": "30"
      },
      "elements": [
        { "id": "sp-dl-1", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [ { "id": "sp-dl-w1", "elType": "widget", "widgetType": "renobattery-download-card",
            "settings": { "icon": "file-pdf", "title": "Datasheet", "subtitle": "Technical specifications",
              "file_url": "{{acf:datasheet_pdf}}", "css_classes": "rb-download-card" } } ] },
        { "id": "sp-dl-2", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [ { "id": "sp-dl-w2", "elType": "widget", "widgetType": "renobattery-download-card",
            "settings": { "icon": "file-pdf", "title": "User Manual", "subtitle": "Installation & operation",
              "file_url": "{{acf:manual_pdf}}", "css_classes": "rb-download-card" } } ] },
        { "id": "sp-dl-3", "elType": "column", "settings": { "_column_size": 33, "_column_size_mobile": 100 },
          "elements": [ { "id": "sp-dl-w3", "elType": "widget", "widgetType": "renobattery-download-card",
            "settings": { "icon": "certificate", "title": "Certifications", "subtitle": "UL / IEC / CE",
              "repeater_source": "acf:certifications", "css_classes": "rb-download-card" } } ] }
      ]
    },

    {
      "id": "sp-related",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1440 },
        "css_classes": "rb-section rb-product-related",
        "background_color": "#FAFAFA",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [
        { "id": "sp-rel-col", "elType": "column", "settings": { "_column_size": 100 }, "elements": [
          { "id": "sp-rel-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Related Products", "header_size": "span", "css_classes": "rb-eyebrow",
              "typography_font_size": { "unit": "rem", "size": 0.75 },
              "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase",
              "title_color": "#71717A" } },
          { "id": "sp-rel-title", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "You may also consider.", "header_size": "h2",
              "typography_font_size": { "unit": "rem", "size": 2.5 }, "typography_font_weight": "600",
              "typography_letter_spacing": { "unit": "em", "size": -0.02 },
              "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 40, "left": 0 } } },
          { "id": "sp-rel-grid", "elType": "widget", "widgetType": "posts",
            "settings": { "query_post_type": "product", "query_related_taxonomies": ["product_cat"],
              "query_related_fallback": "yes", "query_posts_per_page": 3,
              "query_exclude_current": "yes", "skin": "cards", "template": "product-card",
              "columns": 3, "columns_tablet": 2, "columns_mobile": 1,
              "row_gap": { "unit": "px", "size": 32 }, "column_gap": { "unit": "px", "size": 32 },
              "css_classes": "rb-grid rb-grid--products" } }
        ] }
      ]
    },

    {
      "id": "sp-cta",
      "elType": "section",
      "_ref": "component-cta-section.json"
    }
  ]
}
