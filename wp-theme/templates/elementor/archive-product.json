{
  "version": "0.4",
  "title": "RB / Archive — Product",
  "type": "archive",
  "condition": { "type": "archive", "post_type": "product", "include_taxonomies": ["product_cat", "application_cat"] },
  "page_settings": {
    "template": "elementor_header_footer",
    "css_classes": "rb-page rb-page--archive rb-page--products"
  },
  "content": [
    {
      "id": "arch-hero",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "stretch_section": "section-stretched",
        "min_height": { "unit": "vh", "size": 60 },
        "content_position": "middle",
        "css_classes": "rb-archive-hero is-dark",
        "background_background": "classic",
        "background_color": "#0A0A0A",
        "background_image": { "url": "{{taxonomy:image}}" },
        "background_size": "cover",
        "background_overlay_background": "gradient",
        "background_overlay_color": "rgba(10,10,10,0.7)",
        "background_overlay_color_b": "rgba(10,10,10,0.3)",
        "padding": { "unit": "px", "top": "160", "right": "40", "bottom": "80", "left": "40",
          "mobile": { "top": "120", "right": "20", "bottom": "64", "left": "20" } }
      },
      "elements": [
        {
          "id": "arch-hero-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            { "id": "arch-breadcrumbs", "elType": "widget", "widgetType": "breadcrumbs",
              "settings": { "separator": "/", "text_color": "rgba(255,255,255,0.6)",
                "typography_font_size": { "unit": "rem", "size": 0.8125 },
                "typography_letter_spacing": { "unit": "em", "size": 0.04 } } },
            { "id": "arch-eye", "elType": "widget", "widgetType": "heading",
              "settings": { "title": "Products", "header_size": "span", "css_classes": "rb-eyebrow",
                "title_color": "rgba(255,255,255,0.6)",
                "typography_font_size": { "unit": "rem", "size": 0.75 },
                "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase",
                "_margin": { "unit": "px", "top": 16, "right": 0, "bottom": 12, "left": 0 } } },
            { "id": "arch-title", "elType": "widget", "widgetType": "archive-title",
              "settings": { "header_size": "h1",
                "typography_font_size": { "unit": "rem", "size": 4.5 },
                "typography_font_size_mobile": { "unit": "rem", "size": 2.5 },
                "typography_font_weight": "600",
                "typography_letter_spacing": { "unit": "em", "size": -0.03 },
                "typography_line_height": { "unit": "em", "size": 1.05 },
                "title_color": "#FFFFFF", "_animation": "fadeInUp" } },
            { "id": "arch-desc", "elType": "widget", "widgetType": "archive-description",
              "settings": { "typography_font_size": { "unit": "rem", "size": 1.25 },
                "typography_line_height": { "unit": "em", "size": 1.55 },
                "text_color": "rgba(255,255,255,0.8)",
                "_element_custom_width": "yes", "_element_width_custom": { "unit": "px", "size": 720 },
                "_margin": { "unit": "px", "top": 20, "right": 0, "bottom": 0, "left": 0 },
                "_animation": "fadeInUp", "_animation_delay": 120 } }
          ]
        }
      ]
    },

    {
      "id": "arch-filters",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1440 },
        "css_classes": "rb-filterbar",
        "background_color": "#FFFFFF",
        "position": "sticky",
        "_position_top": { "unit": "px", "size": 72 },
        "z_index": 50,
        "border_border": "solid",
        "border_width": { "unit": "px", "top": 0, "right": 0, "bottom": 1, "left": 0 },
        "border_color": "#E5E5E7",
        "padding": { "unit": "px", "top": "16", "right": "40", "bottom": "16", "left": "40",
          "mobile": { "top": "12", "right": "20", "bottom": "12", "left": "20" } }
      },
      "elements": [
        {
          "id": "arch-filters-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "arch-filters-widget",
              "elType": "widget",
              "widgetType": "renobattery-taxonomy-filter",
              "settings": {
                "taxonomies": ["product_cat", "application_cat"],
                "show_count": true,
                "mode": "ajax",
                "layout": "pills",
                "css_classes": "rb-filter-pills",
                "pill_active_bg": "#0A0A0A",
                "pill_active_color": "#FFFFFF",
                "pill_inactive_bg": "#F4F4F5",
                "pill_inactive_color": "#52525B",
                "sort_options": [
                  { "value": "date-desc", "label": "Newest" },
                  { "value": "capacity-desc", "label": "Highest Capacity" },
                  { "value": "title-asc", "label": "A → Z" }
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "id": "arch-grid",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": { "unit": "px", "size": 1440 },
        "css_classes": "rb-section rb-section--archive-grid",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "64", "right": "40", "bottom": "120", "left": "40",
          "mobile": { "top": "40", "right": "20", "bottom": "80", "left": "20" } }
      },
      "elements": [
        {
          "id": "arch-grid-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "arch-grid-widget",
              "elType": "widget",
              "widgetType": "archive-posts",
              "settings": {
                "skin": "cards",
                "template": "product-card",
                "columns": 3,
                "columns_tablet": 2,
                "columns_mobile": 1,
                "row_gap": { "unit": "px", "size": 40 },
                "column_gap": { "unit": "px", "size": 32 },
                "posts_per_page": 12,
                "pagination": "load_more",
                "pagination_load_more_text": "Load more",
                "css_classes": "rb-grid rb-grid--products",
                "_animation": "fadeInUp"
              }
            },
            {
              "id": "arch-empty-state",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[rb_archive_empty_state post_type='product']",
                "css_classes": "rb-empty"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "arch-cta",
      "elType": "section",
      "_ref": "component-cta-section.json"
    }
  ]
}
