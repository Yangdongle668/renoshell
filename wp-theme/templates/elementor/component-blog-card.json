{
  "version": "0.4",
  "title": "RB / Blog Card",
  "type": "section",
  "content": [
    {
      "id": "blog-card",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "gap": "no",
        "css_classes": "rb-card rb-blog-card",
        "background_color": "#FFFFFF",
        "border_radius": { "unit": "px", "top": 16, "right": 16, "bottom": 16, "left": 16 },
        "padding": { "unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0 }
      },
      "elements": [
        {
          "id": "blog-card-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "blog-card-media",
              "elType": "widget",
              "widgetType": "theme-post-featured-image",
              "settings": {
                "image_size": "rb-card",
                "link_to": "post",
                "css_classes": "rb-blog-card__media",
                "image_border_radius": { "unit": "px", "top": 16, "right": 16, "bottom": 0, "left": 0 }
              }
            },
            {
              "id": "blog-card-body",
              "elType": "section",
              "isInner": true,
              "settings": {
                "padding": { "unit": "px", "top": "24", "right": "24", "bottom": "28", "left": "24" },
                "css_classes": "rb-blog-card__body"
              },
              "elements": [
                {
                  "id": "blog-card-body-col",
                  "elType": "column",
                  "settings": { "_column_size": 100 },
                  "elements": [
                    {
                      "id": "blog-card-meta",
                      "elType": "widget",
                      "widgetType": "post-info",
                      "settings": {
                        "meta_data": [
                          { "type": "terms", "taxonomy": "category" },
                          { "type": "date", "date_format": "F j, Y" }
                        ],
                        "show_icons": "",
                        "separator_between": "bullet",
                        "css_classes": "rb-blog-card__meta",
                        "text_color": "#71717A",
                        "typography_typography": "custom",
                        "typography_font_size": { "unit": "rem", "size": 0.8125 },
                        "typography_letter_spacing": { "unit": "em", "size": 0.04 },
                        "typography_text_transform": "uppercase",
                        "typography_font_weight": "600"
                      }
                    },
                    {
                      "id": "blog-card-title",
                      "elType": "widget",
                      "widgetType": "post-title",
                      "settings": {
                        "header_size": "h3",
                        "link": "yes",
                        "css_classes": "rb-blog-card__title",
                        "typography_typography": "custom",
                        "typography_font_size": { "unit": "rem", "size": 1.375 },
                        "typography_font_weight": "600",
                        "typography_line_height": { "unit": "em", "size": 1.25 },
                        "typography_letter_spacing": { "unit": "em", "size": -0.005 },
                        "title_color": "#0A0A0A",
                        "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 12, "left": 0 }
                      }
                    },
                    {
                      "id": "blog-card-excerpt",
                      "elType": "widget",
                      "widgetType": "post-excerpt",
                      "settings": {
                        "excerpt_length": 22,
                        "css_classes": "rb-blog-card__excerpt",
                        "typography_font_size": { "unit": "rem", "size": 0.9375 },
                        "typography_line_height": { "unit": "em", "size": 1.55 },
                        "text_color": "#52525B"
                      }
                    },
                    {
                      "id": "blog-card-read",
                      "elType": "widget",
                      "widgetType": "button",
                      "settings": {
                        "text": "Read article",
                        "link": { "url": "{{post:permalink}}" },
                        "size": "sm",
                        "css_classes": "rb-btn rb-btn--ghost rb-btn--arrow",
                        "button_text_color": "#0A0A0A",
                        "background_color": "transparent",
                        "hover_color": "#E31937",
                        "text_padding": { "unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0 },
                        "selected_icon": { "value": "fas fa-arrow-right", "library": "fa-solid" },
                        "icon_align": "right",
                        "icon_indent": { "unit": "px", "size": 8 },
                        "_margin": { "unit": "px", "top": 20, "right": 0, "bottom": 0, "left": 0 }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "isInner": false
    }
  ],
  "page_settings": []
}
