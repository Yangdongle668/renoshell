{
  "meta": {
    "name": "renobattery-tokens",
    "version": "1.0.0",
    "philosophy": "Tesla-grade minimalism: high contrast, generous whitespace, cinematic typography, restrained motion.",
    "base_font_px": 16,
    "export_targets": ["assets/css/tokens.css", "elementor global styles", "acf options"]
  },

  "color": {
    "brand": {
      "primary":        "#0A0A0A",
      "primary_ink":    "#111111",
      "accent":         "#E31937",
      "accent_hover":   "#FF2C48",
      "electric_blue":  "#1B6CFF"
    },
    "neutral": {
      "white":   "#FFFFFF",
      "n50":     "#FAFAFA",
      "n100":    "#F4F4F5",
      "n200":    "#E5E5E7",
      "n300":    "#D1D1D6",
      "n400":    "#A1A1AA",
      "n500":    "#71717A",
      "n600":    "#52525B",
      "n700":    "#3F3F46",
      "n800":    "#27272A",
      "n900":    "#18181B",
      "black":   "#000000"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger":  "#EF4444",
      "info":    "#1B6CFF"
    },
    "surface": {
      "bg_light":      "#FFFFFF",
      "bg_subtle":     "#FAFAFA",
      "bg_dark":       "#0A0A0A",
      "bg_dark_raised":"#141416",
      "overlay_40":    "rgba(0,0,0,0.40)",
      "overlay_60":    "rgba(0,0,0,0.60)",
      "glass":         "rgba(255,255,255,0.06)"
    },
    "text": {
      "on_light_primary":   "#0A0A0A",
      "on_light_secondary": "#52525B",
      "on_light_muted":     "#A1A1AA",
      "on_dark_primary":    "#FFFFFF",
      "on_dark_secondary":  "#D1D1D6",
      "on_dark_muted":      "#71717A",
      "link":               "#1B6CFF",
      "link_hover":         "#0A0A0A"
    },
    "border": {
      "subtle": "#E5E5E7",
      "strong": "#111111",
      "dark":   "#27272A"
    }
  },

  "typography": {
    "font_family": {
      "sans_en":   "'Inter', 'Helvetica Neue', Arial, sans-serif",
      "sans_zh":   "'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif",
      "display":   "'Inter Display', 'Inter', sans-serif",
      "mono":      "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "weight": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "letter_spacing": {
      "tight":  "-0.03em",
      "snug":   "-0.01em",
      "normal": "0",
      "wide":   "0.04em",
      "caps":   "0.12em"
    },
    "line_height": {
      "display": 1.05,
      "heading": 1.15,
      "body":    1.6,
      "tight":   1.3
    },
    "scale_rem": {
      "display_xl": { "size": "6.25rem", "weight": 600, "lh": 1.02, "ls": "-0.03em", "note": "Hero Tesla-style" },
      "display_lg": { "size": "4.5rem",  "weight": 600, "lh": 1.05, "ls": "-0.03em" },
      "display_md": { "size": "3.5rem",  "weight": 600, "lh": 1.08, "ls": "-0.02em" },
      "h1":         { "size": "3rem",    "weight": 600, "lh": 1.1,  "ls": "-0.02em" },
      "h2":         { "size": "2.25rem", "weight": 600, "lh": 1.15, "ls": "-0.015em" },
      "h3":         { "size": "1.75rem", "weight": 600, "lh": 1.2,  "ls": "-0.01em" },
      "h4":         { "size": "1.375rem","weight": 600, "lh": 1.25, "ls": "-0.005em" },
      "h5":         { "size": "1.125rem","weight": 600, "lh": 1.3,  "ls": "0" },
      "lead":       { "size": "1.25rem", "weight": 400, "lh": 1.55, "ls": "0" },
      "body_lg":    { "size": "1.125rem","weight": 400, "lh": 1.6,  "ls": "0" },
      "body":       { "size": "1rem",    "weight": 400, "lh": 1.6,  "ls": "0" },
      "body_sm":    { "size": "0.875rem","weight": 400, "lh": 1.55, "ls": "0" },
      "caption":    { "size": "0.8125rem","weight": 500,"lh": 1.4,  "ls": "0.04em" },
      "eyebrow":    { "size": "0.75rem", "weight": 600, "lh": 1.2,  "ls": "0.12em", "transform": "uppercase" }
    },
    "responsive_clamp": {
      "display_xl": "clamp(2.75rem, 6.5vw, 6.25rem)",
      "display_lg": "clamp(2.25rem, 5vw, 4.5rem)",
      "display_md": "clamp(2rem, 4vw, 3.5rem)",
      "h1":         "clamp(1.875rem, 3.2vw, 3rem)",
      "h2":         "clamp(1.5rem, 2.4vw, 2.25rem)"
    }
  },

  "spacing": {
    "unit_px": 4,
    "scale": {
      "0":  "0",
      "1":  "0.25rem",
      "2":  "0.5rem",
      "3":  "0.75rem",
      "4":  "1rem",
      "5":  "1.25rem",
      "6":  "1.5rem",
      "8":  "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "32": "8rem",
      "40": "10rem",
      "48": "12rem",
      "64": "16rem"
    },
    "section_padding_y": {
      "compact":   "clamp(3rem, 6vw, 5rem)",
      "default":   "clamp(5rem, 9vw, 8rem)",
      "spacious":  "clamp(7rem, 12vw, 12rem)",
      "cinematic": "100vh"
    },
    "container_padding_x": {
      "mobile":  "1.25rem",
      "tablet":  "2rem",
      "desktop": "4rem"
    }
  },

  "layout": {
    "breakpoints_px": {
      "xs": 360,
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280,
      "2xl": 1536,
      "3xl": 1920
    },
    "container_max": {
      "sm":  "640px",
      "md":  "768px",
      "lg":  "1024px",
      "xl":  "1200px",
      "2xl": "1440px",
      "full":"100%"
    },
    "grid": {
      "columns": 12,
      "gutter":  "1.5rem",
      "row_gap": "2rem"
    },
    "z_index": {
      "base":    1,
      "content": 10,
      "sticky":  100,
      "navbar":  900,
      "overlay": 1000,
      "modal":   1100,
      "toast":   1200
    }
  },

  "radius": {
    "none": "0",
    "sm":   "2px",
    "md":   "4px",
    "lg":   "8px",
    "xl":   "12px",
    "2xl":  "16px",
    "3xl":  "24px",
    "pill": "999px"
  },

  "shadow": {
    "none":       "none",
    "xs":         "0 1px 2px rgba(0,0,0,0.04)",
    "sm":         "0 2px 4px rgba(0,0,0,0.06)",
    "md":         "0 6px 16px rgba(0,0,0,0.08)",
    "lg":         "0 12px 32px rgba(0,0,0,0.10)",
    "xl":         "0 24px 64px rgba(0,0,0,0.14)",
    "cinematic":  "0 40px 120px rgba(0,0,0,0.28)",
    "inset":      "inset 0 1px 0 rgba(255,255,255,0.06)",
    "focus_ring": "0 0 0 3px rgba(27,108,255,0.35)"
  },

  "border_width": {
    "0":  "0",
    "1":  "1px",
    "2":  "2px",
    "4":  "4px"
  },

  "motion": {
    "duration": {
      "instant": "0ms",
      "fast":    "160ms",
      "base":    "240ms",
      "slow":    "420ms",
      "slower":  "720ms",
      "cinema":  "1200ms"
    },
    "easing": {
      "standard":  "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter":     "cubic-bezier(0.0, 0, 0.2, 1)",
      "exit":      "cubic-bezier(0.4, 0, 1, 1)",
      "spring":    "cubic-bezier(0.16, 1, 0.3, 1)",
      "tesla":     "cubic-bezier(0.25, 1, 0.35, 1)"
    },
    "reduced_motion_fallback": "duration:0ms; transform:none; opacity:1"
  },

  "elevation_dark_mode": {
    "enabled": true,
    "auto_invert_sections_with_class": "is-dark",
    "hero_default": "dark"
  },

  "button_tokens": {
    "height": { "sm": "36px", "md": "44px", "lg": "52px" },
    "padding_x": { "sm": "14px", "md": "20px", "lg": "28px" },
    "font_size": { "sm": "0.8125rem", "md": "0.9375rem", "lg": "1rem" },
    "radius": "pill",
    "letter_spacing": "0.04em",
    "transition": "all 240ms cubic-bezier(0.25,1,0.35,1)"
  },

  "icon": {
    "size": { "sm": "16px", "md": "20px", "lg": "24px", "xl": "32px" },
    "stroke_width": 1.5,
    "style": "outline"
  },

  "css_variable_export": {
    "selector": ":root",
    "prefix": "--rb",
    "examples": [
      "--rb-color-bg: #FFFFFF",
      "--rb-color-ink: #0A0A0A",
      "--rb-color-accent: #E31937",
      "--rb-font-sans: 'Inter', 'PingFang SC', sans-serif",
      "--rb-space-8: 2rem",
      "--rb-radius-pill: 999px",
      "--rb-shadow-cinematic: 0 40px 120px rgba(0,0,0,0.28)",
      "--rb-ease-tesla: cubic-bezier(0.25,1,0.35,1)",
      "--rb-dur-slow: 420ms"
    ]
  },

  "elementor_global_mapping": {
    "colors": {
      "primary":   "brand.primary",
      "secondary": "brand.accent",
      "text":      "text.on_light_primary",
      "accent":    "brand.electric_blue"
    },
    "typography": {
      "primary":   "scale_rem.h1",
      "secondary": "scale_rem.h3",
      "text":      "scale_rem.body",
      "accent":    "scale_rem.eyebrow"
    }
  }
}
