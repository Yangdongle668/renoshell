{
  "meta": {
    "project":    "renobattery — Tesla-style B2B battery manufacturer theme",
    "stack":      "WordPress 6.4+, PHP 8.1+, Elementor Pro 3.21+, ACF Pro, Polylang",
    "parent":     "hello-elementor",
    "i18n":       ["en (default)", "zh"],
    "reuse_notice": "Prior artifacts from earlier run are reusable: architecture, tokens, 5 core components, 3 page templates, animation spec, performance spec, 4 custom widgets, tokens.css, components.css. Remaining gaps are addressed in this plan."
  },

  "phases": [
    {
      "id": "P1", "name": "Foundation",
      "steps": ["STEP 1", "STEP 2"],
      "deliverables": ["architecture JSON", "design tokens JSON", "tokens.css"],
      "status_existing": "done (re-verify in STEP 1/2)",
      "blocks": ["P2", "P3", "P4"]
    },
    {
      "id": "P2", "name": "Global shell",
      "steps": ["STEP 3"],
      "deliverables": ["navbar.json", "footer.json", "mega-menu spec", "mobile drawer spec"],
      "status_existing": "partial — navbar + footer exist, need mega menu + mobile drawer + language switcher detail",
      "blocks": ["P4", "P5"]
    },
    {
      "id": "P3", "name": "Core UI kit",
      "steps": ["STEP 4"],
      "deliverables": ["hero", "product-card", "cta", "feature-section", "product-spec-table", "case-card", "blog-card", "timeline", "contact-form"],
      "status_existing": "partial — hero, product-card, cta done; need feature-section, case-card, blog-card, timeline, contact-form",
      "blocks": ["P4"]
    },
    {
      "id": "P4", "name": "Page templates phase 1",
      "steps": ["STEP 5"],
      "deliverables": ["page-home", "archive-product", "single-product"],
      "status_existing": "done (reusable)",
      "blocks": ["P5"]
    },
    {
      "id": "P5", "name": "Page templates phase 2",
      "steps": ["STEP 6"],
      "deliverables": [
        "archive-case_study", "single-case_study",
        "archive-application", "single-application",
        "archive-blog", "single-blog",
        "page-about", "page-contact", "page-careers",
        "page-privacy", "page-cookies"
      ],
      "status_existing": "not started — full build required",
      "blocks": ["P6", "P7"]
    },
    {
      "id": "P6", "name": "Motion & interaction",
      "steps": ["STEP 7"],
      "deliverables": ["motion spec JSON", "assets/js/motion.js", "assets/js/navbar.js", "assets/css/motion.css"],
      "status_existing": "spec done; JS/CSS files pending",
      "blocks": ["P8"]
    },
    {
      "id": "P7", "name": "Bilingual",
      "steps": ["STEP 8"],
      "deliverables": ["polylang config JSON", "string-translation seed", "zh_CN.po seed", "language-switcher integration"],
      "status_existing": "not started",
      "blocks": ["P9"]
