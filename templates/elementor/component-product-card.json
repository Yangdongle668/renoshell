{
  "version": "0.4",
  "title": "RB / Product Card",
  "type": "section",
  "content": [
    {
      "id": "pcard001",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "gap": "no",
        "css_classes": "rb-card rb-card--product",
        "background_background": "classic",
        "background_color": "#FAFAFA",
        "border_radius": { "unit": "px", "top": 16, "right": 16, "bottom": 16, "left": 16 },
        "padding": { "unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0 },
        "_element_custom_width": "yes",
        "motion_fx_motion_fx_scrolling": "yes",
        "hover_transition": { "unit": "ms", "size": 420 }
      },
      "elements": [
        {
          "id": "pcardcol01",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "pcardimg01",
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": { "url": "{{acf:gallery.0.sizes.large}}", "alt": "{{post:title}}" },
                "image_size": "large",
                "link_to": "custom",
                "link": { "url": "{{post:permalink}}" },
                "css_classes": "rb-card__media",
                "image_border_radius": { "unit": "px", "top": 16, "right": 16, "bottom": 0, "left": 0 },
                "_css_filters_css_filter": "yes",
                "hover_animation": "grow"
              }
            },
            {
              "id": "pcardbody01",
              "elType": "section",
              "isInner": true,
              "settings": {
                "padding": { "unit": "px", "top": 24, "right": 24, "bottom": 28, "left": 24 },
                "css_classes": "rb-card__body"
              },
              "elements": [
                {
                  "id": "pcardinnercol01",
                  "elType": "column",
                  "settings": { "_column_size": 100 },
                  "elements": [
                    {
                      "id": "pcardeyebrow01",
                      "elType": "widget",
                      "widgetType": "heading",
                      "settings": {
                        "title": "{{tax:product_cat.name}}",
                        "header_size": "span",
                        "css_classes": "rb-eyebrow",
                        "typography_font_size": { "unit": "rem", "size": 0.75 },
                        "typography_letter_spacing": { "unit": "em", "size": 0.12 },
                        "typography_text_transform": "uppercase",
                        "typography_font_weight": "600",
                        "title_color": "#71717A"
                      }
                    },
                    {
                      "id": "pcardtitle01",
                      "elType": "widget",
                      "widgetType": "heading",
                      "settings": {
                        "title": "{{post:title}}",
                        "header_size": "h3",
                        "link": { "url": "{{post:permalink}}" },
                        "css_classes": "rb-card__title",
                        "typography_font_size": { "unit": "rem", "size": 1.375 },
                        "typography_font_weight": "600",
                        "typography_line_height": { "unit": "em", "size": 1.2 },
                        "title_color": "#0A0A0A",
                        "_margin": { "unit": "px", "top": 8, "right": 0, "bottom": 16, "left": 0 }
                      }
                    },
                    {
                      "id": "pcardspecs01",
                      "elType": "widget",
                      "widgetType": "icon-list",
                      "settings": {
                        "css_classes": "rb-card__specs",
                        "icon_list": [
                          {
                            "text": "{{acf:battery_capacity}} Ah",
                            "selected_icon": { "value": "fas fa-bolt", "library": "fa-solid" }
                          },
                          {
                            "text": "{{acf:nominal_voltage}} V",
                            "selected_icon": { "value": "fas fa-plug", "library": "fa-solid" }
                          },
                          {
                            "text": "{{acf:cycle_life}} cycles",
                            "selected_icon": { "value": "fas fa-sync", "library": "fa-solid" }
                          }
                        ],
                        "icon_color": "#1B6CFF",
                        "text_color": "#52525B",
                        "typography_font_size": { "unit": "rem", "size": 0.875 },
                        "space_between": { "unit": "px", "size": 6 }
                      }
                    },
                    {
                      "id": "pcardcta01",
                      "elType": "widget",
                      "widgetType": "button",
                      "settings": {
                        "text": "View Details",
                        "link": { "url": "{{post:permalink}}" },
                        "align": "left",
                        "size": "sm",
                        "css_classes": "rb-btn rb-btn--ghost rb-btn--arrow",
                        "button_text_color": "#0A0A0A",
                        "background_color": "transparent",
                        "hover_color": "#E31937",
                        "text_padding": { "unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0 },
                        "typography_font_size": { "unit": "rem", "size": 0.9375 },
                        "typography_font_weight": "600",
                        "typography_letter_spacing": { "unit": "em", "size": 0.02 },
                        "selected_icon": { "value": "fas fa-arrow-right", "library": "fa-solid" },
                        "icon_align": "right",
                        "icon_indent": { "unit": "px", "size": 8 },
                        "_margin": { "unit": "px", "top": 20, "right": 0, "bottom": 0, "left": 0 }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "isInner": false
    }
  ],
  "page_settings": []
}
