{
  "version": "0.4",
  "title": "RB / Single — Application",
  "type": "single",
  "condition": { "type": "single", "post_type": "application" },
  "page_settings": { "template": "elementor_header_footer", "hide_title": "yes", "css_classes": "rb-page rb-page--single rb-page--application" },
  "content": [
    {
      "id": "app-hero",
      "elType": "section",
      "settings": {
        "layout": "full_width", "stretch_section": "section-stretched",
        "min_height": { "unit": "vh", "size": 75 }, "content_position": "middle",
        "css_classes": "rb-app-hero is-dark",
        "background_background": "classic",
        "background_color": "#0A0A0A",
        "background_image": { "url": "{{acf:hero_bg.url}}" },
        "background_size": "cover",
        "background_overlay_background": "gradient",
        "background_overlay_color": "rgba(10,10,10,0.6)",
        "background_overlay_color_b": "rgba(10,10,10,0.3)",
        "padding": { "unit": "px", "top": "160", "right": "40", "bottom": "96", "left": "40",
          "mobile": { "top": "120", "right": "20", "bottom": "72", "left": "20" } }
      },
      "elements": [{
        "id": "app-hero-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [
          { "id": "app-hero-bc", "elType": "widget", "widgetType": "breadcrumbs",
            "settings": { "text_color": "rgba(255,255,255,0.6)", "typography_font_size": { "unit": "rem", "size": 0.8125 } } },
          { "id": "app-hero-title", "elType": "widget", "widgetType": "post-title",
            "settings": { "header_size": "h1",
              "typography_font_size": { "unit": "rem", "size": 5 }, "typography_font_size_mobile": { "unit": "rem", "size": 2.75 },
              "typography_font_weight": "600", "typography_letter_spacing": { "unit": "em", "size": -0.03 },
              "typography_line_height": { "unit": "em", "size": 1.05 },
              "title_color": "#FFFFFF",
              "_margin": { "unit": "px", "top": 16, "right": 0, "bottom": 20, "left": 0 } } },
          { "id": "app-hero-excerpt", "elType": "widget", "widgetType": "post-excerpt",
            "settings": { "excerpt_length": 30,
              "typography_font_size": { "unit": "rem", "size": 1.25 }, "text_color": "rgba(255,255,255,0.85)",
              "_element_custom_width": "yes", "_element_width_custom": { "unit": "px", "size": 720 } } }
        ]
      }]
    },

    {
      "id": "app-overview",
      "elType": "section",
      "settings": {
        "layout": "boxed", "content_width": { "unit": "px", "size": 900 },
        "css_classes": "rb-section rb-app-overview",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "96", "right": "40", "bottom": "96", "left": "40" }
      },
      "elements": [{
        "id": "app-overview-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [{
          "id": "app-overview-w", "elType": "widget", "widgetType": "theme-post-content",
          "settings": { "typography_font_size": { "unit": "rem", "size": 1.125 }, "typography_line_height": { "unit": "em", "size": 1.75 }, "text_color": "#3F3F46" }
        }]
      }]
    },

    {
      "id": "app-benefits",
      "elType": "section",
      "settings": {
        "layout": "boxed", "content_width": { "unit": "px", "size": 1200 },
        "css_classes": "rb-section rb-app-benefits",
        "background_color": "#FAFAFA",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [{
        "id": "app-benefits-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [
          { "id": "app-benefits-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Benefits", "header_size": "span", "css_classes": "rb-eyebrow", "title_color": "#71717A",
              "typography_font_size": { "unit": "rem", "size": 0.75 }, "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase" } },
          { "id": "app-benefits-title", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Why Renobattery for this application.", "header_size": "h2",
              "typography_font_size": { "unit": "rem", "size": 2.5 }, "typography_font_weight": "600",
              "typography_letter_spacing": { "unit": "em", "size": -0.02 },
              "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 40, "left": 0 } } },
          { "id": "app-benefits-list", "elType": "widget", "widgetType": "shortcode",
            "settings": { "shortcode": "[rb_acf_benefits]", "css_classes": "rb-app-benefits__list" } }
        ]
      }]
    },

    {
      "id": "app-products",
      "elType": "section",
      "settings": {
        "layout": "boxed", "content_width": { "unit": "px", "size": 1440 },
        "css_classes": "rb-section rb-app-products",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "120", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [{
        "id": "app-products-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [
          { "id": "app-products-eye", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Recommended Products", "header_size": "span", "css_classes": "rb-eyebrow", "title_color": "#71717A",
              "typography_font_size": { "unit": "rem", "size": 0.75 }, "typography_letter_spacing": { "unit": "em", "size": 0.12 }, "typography_text_transform": "uppercase" } },
          { "id": "app-products-h", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Proven in this use case.", "header_size": "h2",
              "typography_font_size": { "unit": "rem", "size": 2.5 }, "typography_font_weight": "600",
              "typography_letter_spacing": { "unit": "em", "size": -0.02 },
              "_margin": { "unit": "px", "top": 12, "right": 0, "bottom": 40, "left": 0 } } },
          { "id": "app-products-grid", "elType": "widget", "widgetType": "posts",
            "settings": { "query_post_type": "product", "query_include": "{{acf:recommended_products}}",
              "query_posts_per_page": 3, "skin": "cards", "template": "product-card",
              "columns": 3, "columns_tablet": 2, "columns_mobile": 1,
              "row_gap": { "unit": "px", "size": 32 }, "column_gap": { "unit": "px", "size": 32 },
              "css_classes": "rb-grid rb-grid--products" } }
        ]
      }]
    },

    {
      "id": "app-cases",
      "elType": "section",
      "settings": {
        "layout": "boxed", "content_width": { "unit": "px", "size": 1440 },
        "css_classes": "rb-section rb-app-cases",
        "background_color": "#FAFAFA",
        "padding": { "unit": "px", "top": "96", "right": "40", "bottom": "120", "left": "40" }
      },
      "elements": [{
        "id": "app-cases-col", "elType": "column", "settings": { "_column_size": 100 },
        "elements": [
          { "id": "app-cases-h", "elType": "widget", "widgetType": "heading",
            "settings": { "title": "Related case studies", "header_size": "h2",
              "typography_font_size": { "unit": "rem", "size": 2.25 }, "typography_font_weight": "600",
              "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 32, "left": 0 } } },
          { "id": "app-cases-grid", "elType": "widget", "widgetType": "posts",
            "settings": { "query_post_type": "case_study",
              "query_related_taxonomies": ["application_cat"],
              "query_posts_per_page": 2, "skin": "cards", "template": "case-card",
              "columns": 2, "columns_mobile": 1,
              "row_gap": { "unit": "px", "size": 32 }, "column_gap": { "unit": "px", "size": 32 } } }
        ]
      }]
    },

    { "id": "app-cta", "elType": "section", "_ref": "component-cta-section.json" }
  ]
}
