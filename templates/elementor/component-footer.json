{
  "version": "0.4",
  "title": "RB / Footer (Dark Minimal)",
  "type": "footer",
  "content": [
    {
      "id": "ftr001",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "stretch_section": "section-stretched",
        "gap": "extended",
        "css_classes": "rb-footer is-dark",
        "background_background": "classic",
        "background_color": "#0A0A0A",
        "padding": {
          "unit": "px",
          "top": "96", "right": "40", "bottom": "48", "left": "40",
          "mobile": { "top": "64", "right": "20", "bottom": "32", "left": "20" }
        }
      },
      "elements": [
        {
          "id": "ftrcol-brand",
          "elType": "column",
          "settings": { "_column_size": 30, "_column_size_mobile": 100 },
          "elements": [
            {
              "id": "ftrlogo",
              "elType": "widget",
              "widgetType": "theme-site-logo",
              "settings": {
                "align": "left",
                "width": { "unit": "px", "size": 160 },
                "css_classes": "rb-footer__logo"
              }
            },
            {
              "id": "ftrtagline",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Engineering the next generation of modular energy storage for residential, commercial and utility-scale applications.</p>",
                "text_color": "rgba(255,255,255,0.6)",
                "typography_font_size": { "unit": "rem", "size": 0.9375 },
                "typography_line_height": { "unit": "em", "size": 1.6 },
                "_margin": { "unit": "px", "top": 20, "right": 0, "bottom": 0, "left": 0 }
              }
            },
            {
              "id": "ftrsocial",
              "elType": "widget",
              "widgetType": "social-icons",
              "settings": {
                "shape": "rounded",
                "align": "left",
                "icon_color": "official",
                "icon_primary_color_value": "rgba(255,255,255,0.7)",
                "icon_secondary_color_value": "transparent",
                "icon_size": { "unit": "px", "size": 16 },
                "icon_spacing": { "unit": "px", "size": 12 },
                "social_icon_list": [
                  { "social_icon": { "value": "fab fa-linkedin-in", "library": "fa-brands" }, "link": { "url": "{{option:social.linkedin}}" } },
                  { "social_icon": { "value": "fab fa-youtube",     "library": "fa-brands" }, "link": { "url": "{{option:social.youtube}}" } },
                  { "social_icon": { "value": "fab fa-weixin",      "library": "fa-brands" }, "link": { "url": "{{option:social.wechat}}" } }
                ],
                "_margin": { "unit": "px", "top": 24, "right": 0, "bottom": 0, "left": 0 }
              }
            }
          ]
        },
        {
          "id": "ftrcol-products",
          "elType": "column",
          "settings": { "_column_size": 20, "_column_size_mobile": 50 },
          "elements": [
            {
              "id": "ftrh-products",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Products",
                "header_size": "h6",
                "css_classes": "rb-footer__colhead",
                "title_color": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.75 },
                "typography_letter_spacing": { "unit": "em", "size": 0.12 },
                "typography_text_transform": "uppercase",
                "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 20, "left": 0 }
              }
            },
            {
              "id": "ftrmenu-products",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": {
                "menu": "footer_col_1",
                "layout": "vertical",
                "color_menu_item": "rgba(255,255,255,0.7)",
                "color_menu_item_hover": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.9375 },
                "menu_space_between": { "unit": "px", "size": 10 },
                "css_classes": "rb-footer__menu"
              }
            }
          ]
        },
        {
          "id": "ftrcol-company",
          "elType": "column",
          "settings": { "_column_size": 20, "_column_size_mobile": 50 },
          "elements": [
            {
              "id": "ftrh-company",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Company",
                "header_size": "h6",
                "css_classes": "rb-footer__colhead",
                "title_color": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.75 },
                "typography_letter_spacing": { "unit": "em", "size": 0.12 },
                "typography_text_transform": "uppercase",
                "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 20, "left": 0 }
              }
            },
            {
              "id": "ftrmenu-company",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": {
                "menu": "footer_col_2",
                "layout": "vertical",
                "color_menu_item": "rgba(255,255,255,0.7)",
                "color_menu_item_hover": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.9375 },
                "menu_space_between": { "unit": "px", "size": 10 },
                "css_classes": "rb-footer__menu"
              }
            }
          ]
        },
        {
          "id": "ftrcol-resources",
          "elType": "column",
          "settings": { "_column_size": 30, "_column_size_mobile": 100 },
          "elements": [
            {
              "id": "ftrh-resources",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Newsletter",
                "header_size": "h6",
                "css_classes": "rb-footer__colhead",
                "title_color": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.75 },
                "typography_letter_spacing": { "unit": "em", "size": 0.12 },
                "typography_text_transform": "uppercase",
                "typography_font_weight": "600",
                "_margin": { "unit": "px", "top": 0, "right": 0, "bottom": 20, "left": 0 }
              }
            },
            {
              "id": "ftrform",
              "elType": "widget",
              "widgetType": "form",
              "settings": {
                "form_name": "Footer Subscribe",
                "form_fields": [
                  { "field_type": "email", "field_label": "Email", "placeholder": "your@email.com", "required": "true", "width": "100" }
                ],
                "button_text": "Subscribe",
                "button_size": "md",
                "button_background_color": "#FFFFFF",
                "button_text_color": "#0A0A0A",
                "button_border_radius": { "unit": "px", "top": 999, "right": 999, "bottom": 999, "left": 999 },
                "css_classes": "rb-footer__newsletter"
              }
            }
          ]
        }
      ],
      "isInner": false
    },
    {
      "id": "ftr-legal",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "stretch_section": "section-stretched",
        "gap": "default",
        "css_classes": "rb-footer__legal is-dark",
        "background_background": "classic",
        "background_color": "#0A0A0A",
        "border_border": "solid",
        "border_width": { "unit": "px", "top": 1, "right": 0, "bottom": 0, "left": 0 },
        "border_color": "rgba(255,255,255,0.08)",
        "padding": {
          "unit": "px",
          "top": "24", "right": "40", "bottom": "24", "left": "40",
          "mobile": { "top": "20", "right": "20", "bottom": "20", "left": "20" }
        }
      },
      "elements": [
        {
          "id": "ftrlegal-col1",
          "elType": "column",
          "settings": { "_column_size": 50, "_column_size_mobile": 100 },
          "elements": [
            {
              "id": "ftrcopy",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>© [current_year] Renobattery Technology Co., Ltd. All rights reserved.</p>",
                "align": "left",
                "text_color": "rgba(255,255,255,0.5)",
                "typography_font_size": { "unit": "rem", "size": 0.8125 }
              }
            }
          ]
        },
        {
          "id": "ftrlegal-col2",
          "elType": "column",
          "settings": { "_column_size": 50, "_column_size_mobile": 100 },
          "elements": [
            {
              "id": "ftrmenu-legal",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": {
                "menu": "footer_legal",
                "layout": "horizontal",
                "align": "right",
                "align_mobile": "left",
                "color_menu_item": "rgba(255,255,255,0.5)",
                "color_menu_item_hover": "#FFFFFF",
                "typography_font_size": { "unit": "rem", "size": 0.8125 },
                "menu_space_between": { "unit": "px", "size": 24 }
              }
            }
          ]
        }
      ],
      "isInner": false
    }
  ],
  "page_settings": []
}
